# Required. DeepSeek Platform API key.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 多模态模型：论文全文 + 图表页原图一起送进去。
# 换成 deepseek-v4-flash / deepseek-v4-pro 会退化成纯文本，读不到图。
READER_MODEL=deepseek-v4-flash-vision-exp

# Optional local-server settings.
PORT=8787
HOST=127.0.0.1

# Optional shared secret. If set, enter the same value in the extension settings.
READER_ACCESS_TOKEN=choose-a-long-random-string

# Raw PDF upload limit in MiB (PDF 以二进制上传，不再有 base64 膨胀).
MAX_PDF_MB=120

# 解析 PDF 用的 Python（需要 pymupdf）。
PYTHON=python3

# 下载过的 PDF 缓存目录与容量上限（MiB）。反复读同一篇论文时省掉整段下载。
# 超出上限按最久未用淘汰；设成 0 完全关闭缓存。
READER_CACHE_DIR=.cache/pdfs
READER_CACHE_MB=2048
