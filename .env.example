# Required. This is an OpenAI Platform API key, not a ChatGPT subscription.
OPENAI_API_KEY=sk-your-key-here

# Optional local-server settings.
PORT=8787
HOST=127.0.0.1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional shared secret. If set, enter the same value in the extension settings.
READER_ACCESS_TOKEN=choose-a-long-random-string

# PDF upload limit in MiB.
MAX_PDF_MB=50
